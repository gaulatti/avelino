  "observations": [
    "QQuickTextField owns a clipped QQuickTextInput and delegates input/focus behavior",
    "QSGInternalTextNode doAddTextLayout consumes inclusive selectionEnd in this exact version",
    "QQuickTextInput mouse handlers use a private joined layout and need a calendar field mapping after the template mouse path",
    "QQuickTextInput retains logical UTF16 text/selection and provides composition state, formats and blink status",
    "QAccessibleQuickItem has no character rectangles or point offsets in this version; the segmented input supplies them"
  ],
